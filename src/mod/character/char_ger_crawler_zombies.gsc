// clonewars: zombies are battle droids (replaces the autogenerated character script).
// SWBF2's CIS infantry: B1 battle droid, its engineer (orange), assault (red) and assassin (camo) paint schemes
// (the same model with SWBF2's OverrideTexture), and the super battle droid.
main()
{
	r = RandomInt( 100 );
	if( r < 44 )
	{
		self setModel( "cw_bdroid" );
	}
	else if( r < 56 )
	{
		self setModel( "cw_bdroid_eng" );
	}
	else if( r < 68 )
	{
		self setModel( "cw_bdroid_assault" );
	}
	else if( r < 80 )
	{
		self setModel( "cw_bdroid_assassin" );
	}
	else
	{
		self setModel( "cw_sbdroid" );
	}
	self.voice = "german";
}

precache()
{
	precacheModel( "cw_bdroid" );
	precacheModel( "cw_bdroid_eng" );
	precacheModel( "cw_bdroid_assault" );
	precacheModel( "cw_bdroid_assassin" );
	precacheModel( "cw_sbdroid" );
}
